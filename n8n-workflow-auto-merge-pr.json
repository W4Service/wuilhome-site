{
  "name": "Auto-Merge Channex Reviews PR",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "channex-reviews-pr",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "webhookId": "channex-reviews-pr"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.pull_request.title }}",
              "operation": "contains",
              "value2": "Mise à jour avis Channex"
            },
            {
              "value1": "={{ $json.body.action }}",
              "value2": "opened"
            }
          ]
        }
      },
      "id": "check-pr-title",
      "name": "Check if Reviews PR",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Attendre 10 secondes pour laisser les checks GitHub se terminer\nawait new Promise(resolve => setTimeout(resolve, 10000));\n\nconst prNumber = $input.item.json.body.pull_request.number;\nconst prTitle = $input.item.json.body.pull_request.title;\n\nconsole.log(`⏳ Waiting 10s for checks...`);\nconsole.log(`PR #${prNumber}: ${prTitle}`);\n\nreturn {\n  json: {\n    pr_number: prNumber,\n    pr_title: prTitle\n  }\n};"
      },
      "id": "wait-for-checks",
      "name": "Wait for Checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 200]
    },
    {
      "parameters": {
        "resource": "pullRequest",
        "operation": "merge",
        "owner": {
          "__rl": true,
          "value": "Wuilhome",
          "mode": "name"
        },
        "repository": {
          "__rl": true,
          "value": "wuilhome-site",
          "mode": "name"
        },
        "pullRequestNumber": "={{ $json.pr_number }}",
        "additionalParameters": {
          "mergeMethod": "squash",
          "commitTitle": "{{ $json.pr_title }}"
        }
      },
      "id": "merge-pr",
      "name": "Merge PR",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [850, 200],
      "credentials": {
        "githubApi": {
          "id": "github-pat",
          "name": "GitHub PAT"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"message\": \"PR #\" + $json.pr_number + \" merged automatically\", \"pr_title\": $json.pr_title } }}"
      },
      "id": "webhook-response-success",
      "name": "Webhook Response Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": false, \"message\": \"Not a reviews PR, skipped\" } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "webhook-response-skip",
      "name": "Webhook Response Skip",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 400]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Check if Reviews PR",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check if Reviews PR": {
      "main": [
        [
          {
            "node": "Wait for Checks",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Webhook Response Skip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Checks": {
      "main": [
        [
          {
            "node": "Merge PR",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge PR": {
      "main": [
        [
          {
            "node": "Webhook Response Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "updatedAt": "2026-01-17T00:00:00.000Z",
  "versionId": "1"
}
